<?xml version="1.0" encoding="utf-8"?>
<!-- Aucune donnée (contacts, pseudos, réglages TURN chiffrés, session Firebase) ne part en sauvegarde cloud ni en transfert d'appareil -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
